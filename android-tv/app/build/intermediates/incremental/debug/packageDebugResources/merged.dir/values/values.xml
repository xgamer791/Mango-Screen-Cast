    <string name="overlay_later">Not now</string>
    <string name="overlay_message">To start mirroring while another app is open, Android needs Mango Screen Cast For macOS/iOS to have “Display over other apps” permission. If this TV has no settings screen for it, run this once from your Mac:\n\n%1$s</string>
    <string name="overlay_open">Open settings</string>
    <string name="overlay_title">Allow the player to open by itself?</string>
    <string name="pacing_balanced">Balanced</string>
    <string name="pacing_balanced_hint">Shows each frame right away, one per screen refresh. Best for most networks.</string>
    <string name="pacing_fastest">Fastest</string>
    <string name="pacing_fastest_hint">Lowest delay. Motion can stutter if Wi-Fi delivers frames unevenly.</string>
    <string name="pacing_smoothest">Smoothest</string>
    <string name="pacing_smoothest_hint">Holds one frame (about 17 ms) to smooth out a busy Wi-Fi network.</string>
    <string name="paused">Paused on the other device</string>
    <string name="resolution_auto">Auto</string>
    <string name="resolution_auto_value">Auto (%1$s)</string>
    <string name="setting_background">Stay visible after closing the app</string>
    <string name="setting_background_hint">Keeps the TV in Screen Mirroring lists while you use other apps</string>
    <string name="setting_background_needs_overlay">Visible, but Android won’t let the player open by itself while another app is on screen. Run this once from your Mac: %1$s</string>
    <string name="setting_check_updates">Check for updates now</string>
    <string name="setting_check_updates_hint">Current version. New versions come from the project’s GitHub releases.</string>
    <string name="setting_diagnostics">Diagnostics</string>
    <string name="setting_diagnostics_hint">What the TV detected and offers, plus the recent AirPlay log. Useful when reporting a problem.</string>
    <string name="setting_fill">iPhone in landscape</string>
    <string name="setting_fill_hint">iPhones are wider than a TV, so the whole picture leaves black bars above and below. Fill zooms in to cover the TV and cuts off the left and right edges; a 16:9 video then fills the TV exactly. Mac screens are never cropped. While mirroring, press Up or Down to switch.</string>
    <string name="setting_frame_rate">Frame rate</string>
    <string name="setting_frame_rate_hint">The most frames per second Macs and iPhones may send. 120 needs a 120 Hz TV screen, and Apple devices decide what they actually send: turn on Show stats to see it.</string>
    <string name="setting_name">TV name</string>
    <string name="setting_name_hint">What Macs and iPhones show in Screen Mirroring</string>
    <string name="setting_pacing">Frame pacing</string>
    <string name="setting_resolution">Resolution</string>
    <string name="setting_resolution_hint">Apple devices size their picture to this: 720p unless you pick another. Auto offers the most the TV can decode, up to 4K.</string>
    <string name="setting_sound">Sound</string>
    <string name="setting_sound_hint">Play the mirrored device’s sound on the TV</string>
    <string name="setting_stats">Show stats while mirroring</string>
    <string name="setting_stats_hint">You can also press OK on the remote while mirroring</string>
    <string name="setting_updates">Updates</string>
    <string name="setting_updates_hint">Automatic installs new versions while nothing is mirroring. Ask first shows an Update button on the home screen.</string>
