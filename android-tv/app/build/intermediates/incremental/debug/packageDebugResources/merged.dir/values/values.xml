    <style name="Mango.Button" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Mango.Card" parent="">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">24dp</item>
    </style>
    <style name="Mango.CardBody" parent="">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="Mango.CardTitle" parent="">
        <item name="android:textColor">@color/mango</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.Mango" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/mango</item>
