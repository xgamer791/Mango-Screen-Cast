<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The Games page reads RetroArch's playlists, screenshots and the games' gamelist.xml on
         the TV's shared storage; Android 11 and later allow that only with all files access. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The gear panel's Help opens the TV's Help & feedback, which asks for this permission.
         Nothing on this TV declares it, so Mango does, and holds it. -->
    <permission
        android:name="com.android.tv.settings.HELP_SETTINGS_PERMISSION"
        android:protectionLevel="normal" />
    <uses-permission android:name="com.android.tv.settings.HELP_SETTINGS_PERMISSION" />
    <!-- The gear panel's Bluetooth tile opens the TV's Remotes & Accessories slice, whose screen
         (TvSettings' SliceActivity) asks for this; granted once over adb. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Lets mirroring that starts while the app is in the background bring the player up. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Self-updates from GitHub Releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <queries>
        <!-- So Settings can tell whether this TV has a "Display over other apps" screen. -->
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" />
        </intent>
        <!-- So Settings can find the TV's own settings app and open that dashboard
             directly. On Android 11 and later, other apps that handle this action
             are hidden unless they are declared here. -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent>
        <!-- The home screen's streaming apps (apps/StreamingApps.kt): Android 11 and
             later hide other apps, their banners and their launch intents otherwise. -->
        <package android:name="com.netflix.ninja" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.amazon.firetv.youtube" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.cbs.ott" />
        <package android:name="com.cbs.app" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.amazon.firebat" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.hulu.livingroomplus" />
        <package android:name="com.hulu.plus" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.tubitv" />
        <!-- The home screen's Live TV (AppLauncher.LIVE_TV_PACKAGES) and Streaming Store. -->
        <package android:name="com.vt.tv.tvcenter" />
        <package android:name="com.mediatek.wwtv.tvcenter" />
        <package android:name="com.google.android.tv" />
        <package android:name="com.android.tv" />
        <package android:name="com.android.vending" />
        <package android:name="com.amazon.venezia" />
        <!-- The home screen's Emulation tile (AppLauncher.EMULATION_PACKAGES). -->
        <package android:name="com.retroarch.ra32" />
        <package android:name="com.retroarch" />
        <package android:name="com.retroarch.aarch64" />
        <!-- The TV's other apps, which take their places on the home screen's wall after the streaming apps. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- The gear panel's tiles (ui/PanelTiles.kt): the TV's own settings screens. -->
        <package android:name="com.android.tv.settings" />
        <package android:name="com.vt.customsettings" />
        <package android:name="com.vt.tv.input" />
        <package android:name="com.google.android.apps.tv.dreamx" />
        <!-- The menu's Search. -->
        <intent>
            <action android:name="android.search.action.GLOBAL_SEARCH" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:name=".MangoApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mango"
        android:usesCleartextTraffic="true">

        <!-- The Games page (games/GamesActivity.kt): Home's Emulation tile. -->
        <activity
            android:name=".games.GamesActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|smallestScreenSize|orientation|uiMode" />

        <!-- The pages the home screen's menu opens (What to Watch, Featured Free, Live TV, Sports, Search, Streaming Store). -->
        <activity
            android:name=".browse.BrowseActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|smallestScreenSize|orientation|uiMode"
            android:windowSoftInputMode="adjustNothing|stateHidden" />

        <activity
            android:name=".ui.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|smallestScreenSize|orientation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MirrorActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Mango.Fullscreen"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|smallestScreenSize|orientation|uiMode|density" />

        <!--
            The remote's gear. On this Hisense (Google TV) the gear goes through
            Hisense's key handling (com.hisense.KEY_EVENT) to the system, which
            looks up activities for MAIN + LEANBACK_SETTINGS, as TvSettings'
            MainSettings declares them (at priority 3, with no DEFAULT), and
            opens what it finds by component. So this filter has MAIN and
            LEANBACK_SETTINGS. android.settings.SETTINGS with DEFAULT is what
            `am start -a android.settings.SETTINGS` and other apps start.

            The priority is a request only: Android sets an intent filter's
            priority to 0 for an app that isn't privileged, so stock TvSettings
            (privileged, priority 3) comes first while it's enabled. For the
            gear to open Mango Settings, TvSettings has to stay off
            (adb shell pm disable-user com.android.tv.settings), which
            leaves Mango the only MAIN + LEANBACK_SETTINGS handler. Settings'
            last row opens the TV's own settings by component when they're on.
        -->
        <!-- No task affinity: opened by the gear (ui/GearKeyService.kt) it's a task
             of its own, so Back goes back to the app the gear was pressed in.
             Opened from Home, it's in Home's task as before. -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="">
            <intent-filter android:label="@string/settings_gear_label" android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.settings.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- The gear's panel (ui/SettingsMenuActivity.kt), a copy of the Hisense's: its own
             task, over the app the gear was pressed in, which it goes back to as it closes. -->
        <activity
            android:name=".ui.SettingsMenuActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Mango.Menu"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|smallestScreenSize|orientation|uiMode|density" />

        <!-- The remote's gear (ui/GearKeyService.kt): the system takes it before any
             app and gives it only to a system app's panel, so Mango takes it first,
             as an accessibility service filtering keys. Turned on once over adb. -->
        <service
            android:name=".ui.GearKeyService"
            android:exported="true"
            android:label="@string/gear_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gear_key_service" />
        </service>

        <!-- The gear panel's notifications (ui/PanelNotifications.kt). Allowed once over adb. -->
        <service
            android:name=".ui.PanelNotifications"
            android:exported="true"
            android:label="@string/panel_notification_settings"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".ReceiverService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".update.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
