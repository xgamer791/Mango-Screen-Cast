<?xml version="1.0" encoding="utf-8"?>
<!-- A white tile; focused, it gets a mango ring so the remote's place is plain to see
     (the ring's outer corners are the tile's plus its 3 dp, so it runs evenly round them). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/mango" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:left="3dp"
                android:right="3dp"
                android:top="3dp">
                <shape>
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="@dimen/card_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
</selector>
