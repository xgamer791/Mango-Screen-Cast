<?xml version="1.0" encoding="utf-8"?>
<!-- A white disc for the logo, with two translucent blue rings around it. Drawn in a 213 x 213 dp box. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#3B3770FA" />
        </shape>
    </item>
    <item
        android:bottom="18dp"
        android:left="18dp"
        android:right="18dp"
        android:top="18dp">
        <shape android:shape="oval">
            <solid android:color="#853770FA" />
        </shape>
    </item>
    <item
        android:bottom="37dp"
        android:left="37dp"
        android:right="37dp"
        android:top="37dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
