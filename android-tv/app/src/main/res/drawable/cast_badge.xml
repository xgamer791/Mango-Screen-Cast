<?xml version="1.0" encoding="utf-8"?>
<!-- Solid blue disc with two translucent rings around it. Drawn in a 213 x 213 dp box. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#3B3770FA" />
        </shape>
    </item>
    <item
        android:bottom="18dp"
        android:left="18dp"
        android:right="18dp"
        android:top="18dp">
        <shape android:shape="oval">
            <solid android:color="#853770FA" />
        </shape>
    </item>
    <item
        android:bottom="37dp"
        android:left="37dp"
        android:right="37dp"
        android:top="37dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60%p"
                android:centerX="0.38"
                android:centerY="0.30"
                android:startColor="#3B73FB"
                android:endColor="#356CF6" />
        </shape>
    </item>
</layer-list>
