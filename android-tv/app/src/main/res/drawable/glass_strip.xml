<?xml version="1.0" encoding="utf-8"?>
<!--
  The center glass strip: a faint grey base over the black, a light sheen
  from the top edge, and a visible rim. With a wallpaper behind it, the base
  layer is what gets a blurred copy of the wallpaper drawn under it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/home_glass_base" />
            <corners android:radius="12.75dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#14FFFFFF"
                android:centerColor="#06FFFFFF"
                android:centerY="0.4"
                android:endColor="#00FFFFFF" />
            <corners android:radius="12.75dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/border" />
            <corners android:radius="12.75dp" />
        </shape>
    </item>
</layer-list>
