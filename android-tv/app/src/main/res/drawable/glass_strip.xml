<?xml version="1.0" encoding="utf-8"?>
<!--
  The center glass strip: a dark frosted base, a light sheen from the top
  edge, and a thin rim. With a wallpaper behind it, the base layer is what
  gets a blurred copy of the wallpaper drawn under it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#38000000" />
            <corners android:radius="12.75dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#1CFFFFFF"
                android:centerColor="#09FFFFFF"
                android:centerY="0.4"
                android:endColor="#00FFFFFF" />
            <corners android:radius="12.75dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke
                android:width="0.75dp"
                android:color="#24FFFFFF" />
            <corners android:radius="12.75dp" />
        </shape>
    </item>
</layer-list>
