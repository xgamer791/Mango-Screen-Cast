<?xml version="1.0" encoding="utf-8"?>
<!-- Round the search field: a visible border, mango while it has the focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <stroke
                android:width="2dp"
                android:color="@color/mango" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke
                android:width="1.5dp"
                android:color="#B3FFFFFF" />
        </shape>
    </item>
</selector>
