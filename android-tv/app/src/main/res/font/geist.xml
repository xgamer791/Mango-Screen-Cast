<?xml version="1.0" encoding="utf-8"?>
<!-- Geist (Vercel, SIL Open Font License), the app's one typeface. 500 is the lightest weight in the app, so plain text
     answers Medium and textStyle bold answers Bold; SemiBold and the 550 cut are referenced by file. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/geist_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/geist_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/geist_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/geist_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/geist_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/geist_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
