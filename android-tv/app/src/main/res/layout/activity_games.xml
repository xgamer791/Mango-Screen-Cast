<?xml version="1.0" encoding="utf-8"?>
<!--
  The Games page (games/GamesActivity.kt), as the PS5 home on the 960 x 540 dp
  canvas: the focused game's picture across the screen (HeroView), the game
  systems along the top (SystemRow), the focused one's name, what it is and two
  lines about it on the left, and its games along the bottom (GameRow). Margins
  are 64 dp; spacing keeps to 4 · 8 · 12 · 16 · 24 · 32 · 48 · 64.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.mangoscreencast.tv.games.HeroView
        android:id="@+id/games_hero"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Shade from the left, across the top and up from the bottom, under the words and the rows. -->
    <View
        android:layout_width="800dp"
        android:layout_height="match_parent"
        android:background="@drawable/browse_shade_left" />

    <View
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:background="@drawable/browse_shade_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="224dp"
        android:layout_gravity="bottom"
        android:background="@drawable/games_shade_bottom" />

    <!-- Mango TV, then the page's name. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_bold"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:text="@string/home_wordmark"
            android:textColor="#FFFFFF"
            android:textSize="19sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/geist_medium"
            android:includeFontPadding="false"
            android:text="@string/games_page"
            android:textColor="#B8FFFFFF"
            android:textSize="19sp" />
    </LinearLayout>

    <com.mangoscreencast.tv.ui.ClockView
        android:id="@+id/games_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="64dp"
        android:fontFamily="@font/geist_medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="19sp" />

    <!-- The game systems: the selected one larger at the margin, its name beside it. -->
    <com.mangoscreencast.tv.games.SystemRow
        android:id="@+id/games_systems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp" />

    <!-- The focused game (or system): its name, who made it and when, and two lines about it. -->
    <LinearLayout
        android:id="@+id/games_info"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="200dp"
        android:orientation="vertical">

        <!-- 38 sp, shrinking to as little as 26 sp so a long name fits on its line. -->
        <TextView
            android:id="@+id/games_title"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:autoSizeMaxTextSize="38sp"
            android:autoSizeMinTextSize="26sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="@font/geist_bold"
            android:gravity="bottom"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="38sp" />

        <TextView
            android:id="@+id/games_meta"
            style="@style/Mango.BrowseSmall"
            android:layout_marginTop="12dp"
            android:textColor="#B8FFFFFF" />

        <TextView
            android:id="@+id/games_about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/geist_medium"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.3"
            android:maxWidth="440dp"
            android:maxLines="2"
            android:textColor="#E6FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/games_row_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="348dp"
        android:fontFamily="@font/geist_medium"
        android:includeFontPadding="false"
        android:text="@string/games_row"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- The selected system's games: the selected one at the margin, larger while the remote is on them. -->
    <com.mangoscreencast.tv.games.GameRow
        android:id="@+id/games_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="372dp" />

    <!-- When there's nothing to show: why. -->
    <TextView
        android:id="@+id/games_message"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="200dp"
        android:fontFamily="@font/geist_medium"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.3"
        android:textColor="#E6FFFFFF"
        android:textSize="19sp"
        android:visibility="gone" />
</FrameLayout>
