<?xml version="1.0" encoding="utf-8"?>
<!--
  The "Ready to Cast" home screen, on Android TV's 960 x 540 dp canvas (the
  same on 1080p and 4K panels). Content sits in a 60 dp margin on both
  sides; the vertical rhythm from the top is 48 / 114 / 204 / 250 / 384 / 420 / 494.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_background">

    <!-- Wallpaper slot: blank on purpose until there is art for it. -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/geist_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="44sp" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="114dp"
        android:fontFamily="@font/geist_regular"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:maxWidth="560dp"
        android:textColor="#FFFFFF"
        android:textSize="31sp" />

    <!-- Which name to pick, or what a connected device is doing. -->
    <TextView
        android:id="@+id/status_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="204dp"
        android:fontFamily="@font/geist_regular"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:maxWidth="540dp"
        android:textColor="#D9FFFFFF"
        android:textSize="15sp" />

    <FrameLayout
        android:id="@+id/badge"
        android:layout_width="213dp"
        android:layout_height="213dp"
        android:layout_marginStart="627dp"
        android:layout_marginTop="25.5dp"
        android:background="@drawable/cast_badge">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="85dp"
            android:layout_gravity="center"
            android:layout_marginTop="4.5dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_cast_badge" />
    </FrameLayout>

    <!-- The glass strip: three equal columns, each with its icon and text centred. -->
    <LinearLayout
        android:id="@+id/steps"
        android:layout_width="840dp"
        android:layout_height="112dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="250dp"
        android:background="@drawable/glass_strip"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout style="@style/Mango.StepColumn">

            <LinearLayout style="@style/Mango.StepRow">

                <ImageView
                    style="@style/Mango.StepIcon"
                    android:background="@drawable/step_tile"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_step_wifi" />

                <LinearLayout style="@style/Mango.StepText">

                    <TextView
                        android:id="@+id/step_connect"
                        style="@style/Mango.StepTitle"
                        android:text="@string/step_connect" />

                    <TextView
                        style="@style/Mango.StepBody"
                        android:text="@string/step_connect_body" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Mango.StepDivider" />

        <LinearLayout style="@style/Mango.StepColumn">

            <LinearLayout style="@style/Mango.StepRow">

                <ImageView
                    style="@style/Mango.StepIcon"
                    android:background="@drawable/step_tile"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_step_search" />

                <LinearLayout style="@style/Mango.StepText">

                    <TextView
                        android:id="@+id/step_detect"
                        style="@style/Mango.StepTitle"
                        android:text="@string/step_detect" />

                    <TextView
                        style="@style/Mango.StepBody"
                        android:text="@string/step_detect_body" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Mango.StepDivider" />

        <LinearLayout style="@style/Mango.StepColumn">

            <LinearLayout style="@style/Mango.StepRow">

                <ImageView
                    style="@style/Mango.StepIcon"
                    android:background="@drawable/step_tile"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_step_tv" />

                <LinearLayout style="@style/Mango.StepText">

                    <TextView
                        android:id="@+id/step_cast"
                        style="@style/Mango.StepTitle"
                        android:text="@string/step_cast" />

                    <TextView
                        style="@style/Mango.StepBody"
                        android:text="@string/step_cast_body" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/devices_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="384dp"
        android:fontFamily="@font/geist_semibold"
        android:includeFontPadding="false"
        android:text="@string/supported_devices"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <!-- Five tiles across the content width, 24 dp apart. The remote walks them; +More opens Settings. -->
    <LinearLayout
        android:layout_width="840dp"
        android:layout_height="56dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="420dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/tile_samsung"
            style="@style/Mango.DeviceTile">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="Samsung"
                android:src="@drawable/brand_samsung" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tile_lg"
            style="@style/Mango.DeviceTile"
            android:layout_marginStart="24dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="LG"
                android:src="@drawable/brand_lg" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tile_sony"
            style="@style/Mango.DeviceTile"
            android:layout_marginStart="24dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="Sony"
                android:src="@drawable/brand_sony" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tile_tcl"
            style="@style/Mango.DeviceTile"
            android:layout_marginStart="24dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="TCL"
                android:src="@drawable/brand_tcl" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tile_more"
            style="@style/Mango.DeviceTile"
            android:layout_marginStart="24dp">

            <TextView
                android:id="@+id/more_devices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/geist_medium"
                android:includeFontPadding="false"
                android:text="@string/more_devices"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- The band under the tiles: what the TV offers, and the app version. -->
    <TextView
        android:id="@+id/capability"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="494dp"
        android:ellipsize="end"
        android:fontFamily="@font/geist_regular"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:maxWidth="560dp"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/update_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="494dp"
        android:layout_marginEnd="60dp"
        android:ellipsize="end"
        android:fontFamily="@font/geist_regular"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:maxWidth="300dp"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp" />

    <!-- Top-right corner, clear of the badge's rings. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="60dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/update_button"
            style="@style/Mango.HomeButton"
            android:layout_marginEnd="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/settings_button"
            style="@style/Mango.HomeButton"
            android:text="@string/settings" />
    </LinearLayout>
</FrameLayout>
