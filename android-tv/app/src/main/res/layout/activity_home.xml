<?xml version="1.0" encoding="utf-8"?>
<!--
  The home screen, a clone of the Roku TV home screen on Android TV's 960 x 540 dp
  canvas (the same on 1080p and 4K panels). Every place and size is the Roku
  screen's, measured on a 4450 x 2546 capture: x px × 0.2157, y px × 0.2121.
  The wordmark, clock and item count across the top; the menu on the left,
  only its icons until Left from the wall opens it (HomeMenu); the wall of
  tiles four across, the three Liquid Glass shortcuts first, running on past
  the bottom of the screen, the focused tile's name over its left edge.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_background">

    <!-- Wallpaper, 2560 x 1440: pixel for pixel on the 1440p surface the page is drawn into. Halloween night
         through October, then the three tropical sunsets in turn, each fading in over the last on the
         one above (HomeWallpaper). -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/home_wallpaper_halloween" />

    <ImageView
        android:id="@+id/wallpaper_next"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Mango TV, where the Roku home screen says Roku TV: Geist Bold at the Roku wordmark's cap height. -->
    <TextView
        android:id="@+id/wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="51.8dp"
        android:layout_marginTop="28.6dp"
        android:fontFamily="@font/geist_bold"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:maxLines="1"
        android:text="@string/home_wordmark"
        android:textColor="#FFFFFF"
        android:textSize="27.5sp" />

    <!-- The clock and the count, right edges at 872.3 dp; the clock sits on the wordmark's baseline. -->
    <com.mangoscreencast.tv.ui.ClockView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="40.2dp"
        android:layout_marginEnd="85.9dp"
        android:fontFamily="@font/geist_medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="15.7sp" />

    <TextView
        android:id="@+id/item_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="91.1dp"
        android:layout_marginEnd="86.4dp"
        android:fontFamily="@font/geist_medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#E6FFFFFF"
        android:textSize="13.75sp" />

    <!-- The menu: bars 34.2 dp tall every 35.85 dp, each placed on its own so no rounding adds up;
         the focused one is white. The icons line up with the wordmark's left edge (51.8 dp); the
         bars end where Roku's do (351 dp). -->
    <FrameLayout
        android:id="@+id/menu"
        android:layout_width="311.2dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="39.8dp"
        android:layout_marginTop="116.65dp">

        <TextView
            android:id="@+id/menu_home"
            style="@style/Mango.HomeMenuItem"
            android:drawableStart="@drawable/ic_menu_home"
            android:layout_marginTop="0dp"
            android:text="@string/menu_home" />

        <TextView
            android:id="@+id/menu_what_to_watch"
            style="@style/Mango.HomeMenuItem"
            android:drawableStart="@drawable/ic_menu_what_to_watch"
            android:layout_marginTop="35.85dp"
            android:text="@string/menu_what_to_watch" />

        <TextView
            android:id="@+id/menu_featured_free"
            style="@style/Mango.HomeMenuItem"
            android:drawableStart="@drawable/ic_menu_featured_free"
            android:layout_marginTop="71.7dp"
            android:text="@string/menu_featured_free" />

        <TextView
            android:id="@+id/menu_live_tv"
            style="@style/Mango.HomeMenuItem"
            android:drawableStart="@drawable/ic_menu_live_tv"
            android:layout_marginTop="107.55dp"
            android:text="@string/menu_live_tv" />

        <TextView
            android:id="@+id/menu_sports"
            style="@style/Mango.HomeMenuItem"
            android:drawableStart="@drawable/ic_menu_sports"
            android:layout_marginTop="143.4dp"
            android:text="@string/menu_sports" />

        <TextView
            android:id="@+id/menu_search"
            style="@style/Mango.HomeMenuItem"
            android:drawableStart="@drawable/ic_menu_search"
            android:layout_marginTop="179.25dp"
            android:text="@string/menu_search" />

        <TextView
            android:id="@+id/menu_store"
            style="@style/Mango.HomeMenuItem"
            android:drawableStart="@drawable/ic_menu_store"
            android:layout_marginTop="215.1dp"
            android:text="@string/menu_store" />

        <TextView
            android:id="@+id/menu_settings"
            style="@style/Mango.HomeMenuItem"
            android:drawableStart="@drawable/ic_menu_settings"
            android:layout_marginTop="250.95dp"
            android:text="@string/menu_settings" />
    </FrameLayout>

    <!-- The focused tile's name, over the wall's left edge, on the count's baseline; it moves with the wall. -->
    <TextView
        android:id="@+id/tile_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="84dp"
        android:layout_marginTop="85.8dp"
        android:ellipsize="end"
        android:fontFamily="@font/geist_medium"
        android:includeFontPadding="false"
        android:letterSpacing="0.02"
        android:maxLines="1"
        android:maxWidth="420dp"
        android:textColor="#E6FFFFFF"
        android:textSize="19sp" />

    <!-- The wall: 4 tiles across, 708 dp wide from 84 dp (402.3 dp while the menu is open), the rest
         of the screen's width free on the right, from the bar's top to past the bottom of the screen. See TileGrid. -->
    <com.mangoscreencast.tv.ui.TileWall
        android:id="@+id/tile_wall"
        android:layout_width="708dp"
        android:layout_height="match_parent"
        android:layout_marginStart="84dp"
        android:layout_marginTop="116.9dp">

        <com.mangoscreencast.tv.ui.TileGrid
            android:id="@+id/tile_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.mangoscreencast.tv.ui.TileWall>

    <!-- The arrow right of the wall's first row, level with the menu's bar; hidden while the menu is open. -->
    <ImageView
        android:id="@+id/home_chevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="896.9dp"
        android:layout_marginTop="119.3dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_home_chevron" />

    <!-- Under the menu, only while there's an update to tell about. -->
    <LinearLayout
        android:id="@+id/update_area"
        android:layout_width="268.8dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="82.2dp"
        android:layout_marginTop="440dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/update_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:ellipsize="end"
            android:fontFamily="@font/geist_medium"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="#E6FFFFFF"
            android:textSize="11.2sp" />

        <Button
            android:id="@+id/update_button"
            style="@style/Mango.HomeButton"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
