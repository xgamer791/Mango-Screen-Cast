<?xml version="1.0" encoding="utf-8"?>
<!--
  The home screen, on Android TV's 960 x 540 dp canvas (the same on 1080p
  and 4K panels): the wallpaper, and the apps along the bottom in a 60 dp
  margin on both sides. No headline or glass strip over it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_background">

    <!-- Wallpaper: Manhattan in fog at dusk, 2560 x 1440: pixel for pixel on the 1440p surface the page is drawn into. -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/home_wallpaper" />

    <!-- 30% black over the wallpaper, so the apps and their label stand off it. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000" />

    <!-- Soft light behind the cast badge. -->
    <View
        android:layout_width="760dp"
        android:layout_height="760dp"
        android:layout_marginStart="353.5dp"
        android:layout_marginTop="-248dp"
        android:background="@drawable/home_glow" />

    <TextView
        android:id="@+id/apps_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="380dp"
        android:fontFamily="@font/geist_semibold"
        android:includeFontPadding="false"
        android:text="@string/apps_label"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- A tile per streaming app across the content width, 12 dp apart, filled in
         by AppTiles. The remote walks them; OK opens the app. -->
    <LinearLayout
        android:id="@+id/apps_row"
        android:layout_width="840dp"
        android:layout_height="56dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="416dp"
        android:baselineAligned="false"
        android:orientation="horizontal" />

    <!-- Under the tiles: the app version, or an update's progress. -->
    <TextView
        android:id="@+id/update_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="490dp"
        android:layout_marginEnd="60dp"
        android:ellipsize="end"
        android:fontFamily="@font/geist_regular"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:maxWidth="300dp"
        android:textColor="#B3FFFFFF"
        android:textSize="11.2sp" />

    <!-- Top-right corner, clear of the badge's rings: the update, when there is one.
         The remote's gear opens the menu, so there's no Settings button. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="60dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/update_button"
            style="@style/Mango.HomeButton"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
