<?xml version="1.0" encoding="utf-8"?>
<!-- The gear's panel (ui/SettingsMenuActivity.kt), a copy of the one the Hisense's gear
     opened: over whatever is on screen, which it dims, a rounded panel 272 dp wide,
     24 dp from the right edge and 16 dp from the top and bottom. In it, as there: the
     date and time with All settings and the account, two columns of setting tiles a
     page at a time, the TV's notifications, and the wordmark and Help at the foot. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/menu_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black" />

    <FrameLayout
        android:id="@+id/menu_panel"
        android:layout_width="@dimen/panel_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/panel_margin_vertical"
        android:layout_marginEnd="@dimen/panel_margin_end"
        android:layout_marginBottom="@dimen/panel_margin_vertical"
        android:background="@drawable/panel_background"
        android:clipChildren="false">

        <ScrollView
            android:id="@+id/panel_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fadingEdgeLength="@dimen/panel_fade"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/panel_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="@dimen/panel_inset"
                android:paddingEnd="@dimen/panel_inset"
                android:paddingBottom="48dp">

                <!-- dashboard_profile_tile: 73 dp tall, 9 dp down, 7 dp padding on top. -->
                <FrameLayout
                    android:id="@+id/panel_header"
                    android:layout_width="match_parent"
                    android:layout_height="73dp"
                    android:layout_marginTop="9dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingTop="7dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="3dp"
                        android:orientation="vertical">

                        <TextClock
                            android:id="@+id/panel_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/geist_medium"
                            android:format12Hour="EEE, MMM d"
                            android:format24Hour="EEE, MMM d"
                            android:includeFontPadding="false"
                            android:textColor="@color/panel_time"
                            android:alpha="0.72"
                            android:textSize="12sp" />

                        <TextClock
                            android:id="@+id/panel_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/geist_medium"
                            android:format12Hour="h:mm a"
                            android:format24Hour="HH:mm"
                            android:includeFontPadding="false"
                            android:textColor="@color/panel_time"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <!-- All settings: a round button, its name under it while it has the focus. -->
                    <FrameLayout
                        android:id="@+id/panel_all_settings"
                        android:layout_width="31dp"
                        android:layout_height="31dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="38dp"
                        android:background="@drawable/panel_button_background"
                        android:contentDescription="@string/panel_all_settings"
                        android:focusable="true"
                        android:focusedByDefault="true">

                        <ImageView
                            android:id="@+id/panel_all_settings_icon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_panel_all_settings" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/panel_all_settings_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="42dp"
                        android:layout_marginEnd="25dp"
                        android:alpha="0"
                        android:fontFamily="@font/geist_medium"
                        android:includeFontPadding="false"
                        android:text="@string/panel_all_settings"
                        android:textColor="@color/panel_label"
                        android:textSize="10sp" />

                    <!-- The account: its initial on a disc, as the dashboard shows a monogram. -->
                    <TextView
                        android:id="@+id/panel_account"
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="0dp"
                        android:background="@drawable/panel_avatar_background"
                        android:focusable="true"
                        android:fontFamily="@font/geist_medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@android:color/white"
                        android:textSize="13sp" />
                </FrameLayout>

                <!-- The setting tiles, four down a column and two columns in view (ui/SettingsMenuActivity.kt
                     fills it). 3 dp of room round them for a focused tile's growth; past that they're cut off. -->
                <FrameLayout
                    android:id="@+id/panel_pages"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginStart="-3dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="-3dp"
                    android:clipChildren="true"
                    android:clipToPadding="false"
                    android:padding="3dp" />

                <LinearLayout
                    android:id="@+id/panel_dots"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/panel_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipChildren="false"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- The foot: the wordmark, Help, and the arrow that says there's more below. -->
        <FrameLayout
            android:id="@+id/panel_footer"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/geist_medium"
                android:includeFontPadding="false"
                android:text="@string/panel_wordmark"
                android:textColor="@color/panel_wordmark"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/panel_more"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_panel_more"
                android:tint="@color/panel_content" />

            <FrameLayout
                android:id="@+id/panel_help"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/panel_button_background"
                android:contentDescription="@string/panel_help"
                android:focusable="true">

                <ImageView
                    android:id="@+id/panel_help_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_panel_help" />
            </FrameLayout>
        </FrameLayout>

        <!-- The Sleep timer page, in place of the rest while it's open: its title, then its times. -->
        <LinearLayout
            android:id="@+id/panel_sleep_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/panel_page_background"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/panel_inset"
            android:paddingEnd="@dimen/panel_inset"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/geist_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/panel_sleep_timer"
                android:textColor="@color/panel_title"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/panel_sleep_choices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipChildren="false"
                android:orientation="vertical" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
