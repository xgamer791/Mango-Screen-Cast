<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app's one typeface, Geist, as the default for text, buttons and fields. -->
    <style name="Mango.TextView" parent="@android:style/Widget.DeviceDefault.TextView">
        <item name="android:fontFamily">@font/geist</item>
    </style>

    <style name="Mango.ButtonBase" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:fontFamily">@font/geist_medium</item>
    </style>

    <style name="Mango.EditText" parent="@android:style/Widget.DeviceDefault.EditText">
        <item name="android:fontFamily">@font/geist</item>
    </style>

    <style name="Mango.Button" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:fontFamily">@font/geist_medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Home screen: one column of the glass strip, its icon and text centred both ways. -->

    <!-- The icon and text of one step, centred in the column as a pair. -->

    <!-- The icon tile sits level with the top of the title's capitals (Geist: 0.295 em of ascent above them). -->





    <!-- Home screen: a tile on the wall (TileGrid sizes it), square as Roku's. Focusable, so the remote can walk the wall;
         the focused one gets a mango ring. -->
    <style name="Mango.HomeTile" parent="">
        <item name="android:layout_width">149dp</item>
        <item name="android:layout_height">111dp</item>
        <item name="android:foreground">@drawable/tile_focus</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- Home screen: an item of the menu, Geist at the Roku menu's cap height, tracked out a little to its width,
         its capitals 9.7 dp below the top of its bar. -->
    <style name="Mango.HomeMenuItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">34.2dp</item>
        <item name="android:background">@drawable/home_menu_item</item>
        <item name="android:fontFamily">@font/geist_medium</item>
        <item name="android:gravity">top|start</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">15.2dp</item>
        <item name="android:paddingTop">4.9dp</item>
        <item name="android:textColor">@color/home_menu_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- A pop-up's buttons: the app's button (button_bg, the cards' corners), a little smaller. -->
    <style name="Mango.DialogButton" parent="Mango.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <!-- Home screen: the small corner buttons (Settings, Update). -->
    <style name="Mango.HomeButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/home_button_bg</item>
        <item name="android:fontFamily">@font/geist_medium</item>
        <item name="android:textColor">@color/home_button_text</item>
        <item name="android:textSize">11.2sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Browse pages: the small lines (where it plays, what it is, what OK does). -->
    <style name="Mango.BrowseSmall" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/geist_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">13.3sp</item>
    </style>

    <!-- Browse pages: a button. Square, a visible border, white when focused. -->
    <style name="Mango.BrowseButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/browse_button_bg</item>
        <item name="android:fontFamily">@font/geist_medium</item>
        <item name="android:textColor">@color/browse_button_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
