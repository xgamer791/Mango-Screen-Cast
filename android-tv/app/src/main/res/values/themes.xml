<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mango" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/mango</item>
        <item name="android:colorPrimary">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <!-- Geist everywhere: every TextView and Button starts from it. -->
        <item name="android:textViewStyle">@style/Mango.TextView</item>
        <item name="android:buttonStyle">@style/Mango.ButtonBase</item>
        <item name="android:editTextStyle">@style/Mango.EditText</item>
    </style>

    <style name="Theme.Mango.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
