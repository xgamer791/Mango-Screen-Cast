<?xml version="1.0" encoding="utf-8"?>
<!-- The Home key service (ui/HomeKeyService.kt): it filters keys, and hears
     only of Google TV's launcher bringing up a screen, to see its home come up.
     It gives no feedback of its own. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/home_service_description"
    android:notificationTimeout="0"
    android:packageNames="com.google.android.apps.tv.launcherx" />
