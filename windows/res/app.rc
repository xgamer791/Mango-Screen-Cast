// MangoCast.exe's icon and version information. MANGO_VERSION ("1.2.3") and
// MANGO_VERSION_COMMA (1,2,3,0) come from CMakeLists.txt.
#include <winres.h>

1 ICON "mango.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MANGO_VERSION_COMMA
 PRODUCTVERSION MANGO_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Mango Screen Cast"
            VALUE "FileDescription", "Mango Cast for Windows"
            VALUE "FileVersion", MANGO_VERSION
            VALUE "InternalName", "MangoCast"
            VALUE "OriginalFilename", "MangoCast.exe"
            VALUE "ProductName", "Mango Screen Cast"
            VALUE "ProductVersion", MANGO_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
